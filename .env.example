DATABASE_URL="postgresql://postgres:postgres@localhost:5432/iskillspot?schema=public"
# Direct (non-pooled) connection - Prisma uses DIRECT_URL for migrations and db push.
# Local dev: use the same value as DATABASE_URL. On Supabase, put the direct
# connection string (port 5432) here and the pooled string (port 6543) in DATABASE_URL.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/iskillspot?schema=public"
SESSION_SECRET="change-this-to-a-long-random-string-at-least-32-chars"
NODE_ENV="development"

# Supabase Storage — assignment submission files.
# The bucket must already exist and be created as PRIVATE in the Supabase dashboard.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=

# Optional: passwords for the seeded demo accounts (local development only).
# Leave unset to have the seed generate one-time passwords and write them to
# .seed-credentials.local.json (gitignored). Never seed a production or shared
# database with known passwords.
SEED_ADMIN_PASSWORD=
SEED_TEACHER_PASSWORD=
SEED_STUDENT_PASSWORD=

# Browser push (Web Push / VAPID). Generate a key pair once with:
#   npx web-push generate-vapid-keys
# The public key is safe to expose to browsers; the private key is a server
# secret — never commit a real value, never prefix it with NEXT_PUBLIC_.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Official public origin. HTTPS is required in production. Never inferred from request headers.
LMS_PUBLIC_URL=
# Legacy alias from PR #5. Leave empty, or set to the same origin as LMS_PUBLIC_URL.
APP_URL=

# One transactional email transport for verification, admissions and recovery.
# SMTP takes precedence when configured. Use implicit TLS (465) or STARTTLS (587).
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_REQUIRE_TLS=true
# Resend alternative: used only when SMTP_HOST is empty.
RESEND_API_KEY=

# At least 32 random characters. GET /api/cron/emails every minute uses
# Authorization: Bearer <CRON_SECRET>. POST /api/cron/reminders uses x-cron-secret.
CRON_SECRET=
# Optional IP header overwritten by your trusted reverse proxy. Without this,
# public auth operations share a conservative global source limit.
AUTH_TRUSTED_IP_HEADER=
