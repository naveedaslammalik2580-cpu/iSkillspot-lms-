{
  "name": "iskillspot-lms",
  "version": "1.0.0",
  "private": true,
  "description": "iSkillSpot Learning Management System",
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/prisma-generate.cjs && next build",
    "start": "next start",
    "lint": "eslint .",
    "postinstall": "node scripts/prisma-generate.cjs",
    "auth:bootstrap": "tsx scripts/bootstrap-super-admin.ts",
    "test:auth": "node --test tests/auth.test.cjs",
    "test:auth:integration": "node scripts/test-auth-local.cjs",
    "test:admissions": "node scripts/test-auth-local.cjs",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts && npm run test:auth",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.2.1",
    "@radix-ui/react-label": "^2.1.1",
    "@radix-ui/react-slot": "^1.1.1",
    "@supabase/supabase-js": "^2.112.2",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jose": "^5.9.6",
    "lucide-react": "^0.469.0",
    "next": "15.5.29",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^2.15.0",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "web-push": "^4.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.4",
    "@types/react-dom": "^19.0.2",
    "@types/web-push": "^3.6.4",
    "autoprefixer": "^10.5.4",
    "eslint": "^9.18.0",
    "eslint-config-next": "15.5.29",
    "playwright": "1.62.1",
    "postcss": "^8.4.49",
    "prisma": "^6.2.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
